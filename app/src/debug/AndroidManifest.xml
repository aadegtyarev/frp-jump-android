<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Match MainActivity's terminal resize/configuration behavior in Compose component tests. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            tools:node="merge" />
    </application>
</manifest>
